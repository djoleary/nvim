{
    "cardmarket-php-class-template": {
        "prefix": "cm-php-class",
        "body": [
            "<?php",
            "",
            "declare(strict_types=1);",
            "",
            "namespace ${RELATIVE_FILEPATH/(?<file>[\\/\\\\][CIT]?[A-Z][A-Za-z0-9]+\\.php)|(?<prefix>Classes[\\/\\\\])|(?<path_separator>[\\/\\\\])|(?<path_segment>[A-Za-z0-9]*)/${3:+\\\\}$4/g};",
            "",
            "/**",
            " * Cardmarket (https://www.cardmarket.com)",
            " *",
            " * @copyright Copyright (c) $CURRENT_YEAR, Sammelkartenmarkt GmbH & Co. KG",
            " */",
            "${TM_FILENAME_BASE/^(C[A-Z]).*|^(I[A-Z]).*|^(T[A-Z]).*|^(.*)$/${1:+class}${2:+interface}${3:+trait}${4:+class}/} ${TM_FILENAME_BASE/^[CIT]([A-Z].*$)|^(.*)$/$1$2/}",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Boilerplate for CM PHP Classes",
        "isFileTemplate": true
    },
    "cardmarket-php-test-template": {
        "prefix": "cm-php-test",
        "body": [
            "<?php",
            "",
            "declare(strict_types=1);",
            "",
            "namespace Test\\\\${RELATIVE_FILEPATH/(?<file>[\\/\\\\][A-Za-z0-9]+\\.php)|(?<prefix>\\.tests[\\/\\\\])|(?<path_separator>[\\/\\\\])|(?<path_segment>[A-Za-z0-9]+)/${3:+\\\\}$4/g};",
            "",
            "use PHPUnit\\Framework\\Attributes\\CoversClass;",
            "use PHPUnit\\Framework\\Attributes\\Small;",
            "use Test\\TestCases\\AbstractOfflineTestCase;",
            "",
            "/**",
            " * Cardmarket (https://www.cardmarket.com)",
            " *",
            " * @copyright Copyright (c) $CURRENT_YEAR, Sammelkartenmarkt GmbH & Co. KG",
            " */",
            "#[Small]",
            "#[CoversClass(${TM_FILENAME_BASE/^(.*)Test$/$1/}::class)]",
            "class ${TM_FILENAME_BASE} extends AbstractOfflineTestCase",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Boilerplate for CM PHP Test Classes",
        "isFileTemplate": true
    }
}
